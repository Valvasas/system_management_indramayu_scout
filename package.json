    "drizzle-kit": "^0.31.11",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.56.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
