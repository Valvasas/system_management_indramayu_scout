# Salin ke .env.local lalu isi. Jangan commit nilai asli.
# Semua variabel divalidasi src/lib/env.ts (Zod) saat server start; pesan galat
# hanya menyebut NAMA variabel, tidak pernah nilainya.
# Kosong = tidak diisi.

# --- Situs publik (boleh terlihat di peramban) ---
# Domain kanonik untuk metadata, sitemap, dan JSON-LD. Default: https://pramukaindramayu.or.id
NEXT_PUBLIC_SITE_URL=""

# --- Basis data ---
# Wajib di produksi. Kosong saat pengembangan → PGlite tertanam di PGLITE_DIR.
# Pakai user aplikasi non-superuser yang dibuat docker/db-init (bukan user postgres).
DATABASE_URL=""
# Batas koneksi pool pg (1–100). Default 10.
DATABASE_POOL_MAX=""
# 1 = izinkan PGlite saat NODE_ENV=production (HANYA uji lokal/CI dengan data demo).
ALLOW_PGLITE=""
# Lokasi data PGlite. Default .data/pglite
PGLITE_DIR=""

# Password yang dipakai docker-compose.yml (wajib diisi, tanpa default, HARUS berbeda):
# POSTGRES_PASSWORD = superuser `postgres` (migrasi & retensi log) · APP_DB_PASSWORD = user aplikasi.
POSTGRES_PASSWORD=""
APP_DB_PASSWORD=""

# --- Berkas unggahan ---
# Direktori persisten untuk foto & dokumen. Default ./storage. Sertakan dalam backup.
STORAGE_DIR=""

# --- Sesi ---
# 1 = cookie tanpa Secure/__Host- di produksi (uji `next start` lewat HTTP non-localhost). Jangan di server publik.
INSECURE_COOKIES=""

# --- Enkripsi kolom sensitif (wajib di produksi) ---
# Telepon, alamat, dan data wali anggota + rahasia MFA dienkripsi AES-256-GCM di aplikasi.
# Format "id:kunci" dipisah koma; kunci = openssl rand -base64 32. Rotasi: tambah kunci baru,
# arahkan DATA_ENCRYPTION_KEY_ID ke id baru, jalankan npm run db:encrypt-backfill, baru hapus kunci lama.
# Kosong hanya boleh dengan PGlite (DATABASE_URL kosong) → kunci pengembangan PUBLIK untuk data demo fiktif.
DATA_ENCRYPTION_KEYS=""
# Id kunci aktif untuk enkripsi baru. Boleh kosong bila hanya ada satu kunci.
DATA_ENCRYPTION_KEY_ID=""
# Kunci HMAC (base64 32 byte): blind index, hash kode akses/pemulihan/persetujuan, rantai log audit,
# penyamaran IP di rate limit. Merotasinya membatalkan kode yang beredar & verifikasi log lama.
BLIND_INDEX_KEY=""
# 1 = izinkan kunci pengembangan PUBLIK walau DATABASE_URL terisi (PostgreSQL lokal berisi data demo saja).
# Ditolak di produksi. Tanpa ini, setiap DATABASE_URL wajib DATA_ENCRYPTION_KEYS + BLIND_INDEX_KEY.
ALLOW_DEV_KEYS=""

# --- MFA pengurus ---
# Hari tenggang sebelum pendaftaran TOTP wajib (0–90). Default 7.
MFA_GRACE_DAYS=""

# --- Retensi data (npm run db:retention) ---
# Pesan /kontak (hari, default 365) · log audit (bulan, minimal 6, default 24)
# kode akses kedaluwarsa/terpakai (hari, default 30) · permintaan reset selesai (hari, default 90)
RETENTION_CONTACT_MESSAGES_DAYS=""
RETENTION_AUDIT_LOG_MONTHS=""
RETENTION_ACCESS_CODES_DAYS=""
RETENTION_RESET_REQUESTS_DAYS=""

# --- Backup (npm run db:backup) ---
# Direktori hasil backup (default ./backups) dan jumlah berkas yang disimpan (default 14).
BACKUP_DIR=""
BACKUP_KEEP=""

# --- Pemantauan galat opsional ---
# Aktif hanya bila diisi. Hanya galat server; data pribadi disamarkan sebelum dikirim.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

# --- Integrasi opsional ---
# Teruskan pesan /kontak ke webhook sekretariat (https:// wajib di produksi).
CONTACT_WEBHOOK_URL=""

# --- Khusus skrip (tidak dibaca aplikasi) ---
# npm run db:seed membuat Super Admin bila ketiganya diisi.
ADMIN_USERNAME=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
