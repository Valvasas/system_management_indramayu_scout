# Salin ke .env.local lalu isi. Jangan commit nilai asli.
# Semua variabel divalidasi src/lib/env.ts (Zod) saat server start; pesan galat
# hanya menyebut NAMA variabel, tidak pernah nilainya.
# Kosong = tidak diisi.

# --- Situs publik (boleh terlihat di peramban) ---
# Domain kanonik untuk metadata, sitemap, dan JSON-LD. Default: https://pramukaindramayu.or.id
NEXT_PUBLIC_SITE_URL=""

# --- Basis data ---
# Wajib di produksi. Kosong saat pengembangan → PGlite tertanam di PGLITE_DIR.
# Pakai user aplikasi non-superuser yang dibuat docker/db-init (bukan user postgres).
DATABASE_URL=""
# Batas koneksi pool pg (1–100). Default 10.
DATABASE_POOL_MAX=""
# 1 = izinkan PGlite saat NODE_ENV=production (HANYA uji lokal/CI dengan data demo).
ALLOW_PGLITE=""
# Lokasi data PGlite. Default .data/pglite
PGLITE_DIR=""

# Password DB yang dipakai docker-compose.yml (wajib diisi, tanpa default).
POSTGRES_PASSWORD=""

# --- Berkas unggahan ---
# Direktori persisten untuk foto & dokumen. Default ./storage. Sertakan dalam backup.
STORAGE_DIR=""

# --- Sesi ---
# 1 = cookie tanpa Secure/__Host- di produksi (uji `next start` lewat HTTP non-localhost). Jangan di server publik.
INSECURE_COOKIES=""

# --- Integrasi opsional ---
# Teruskan pesan /kontak ke webhook sekretariat (https:// wajib di produksi).
CONTACT_WEBHOOK_URL=""

# --- Khusus skrip (tidak dibaca aplikasi) ---
# npm run db:seed membuat Super Admin bila ketiganya diisi.
ADMIN_USERNAME=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
