# Salin ke .env.local lalu isi. Jangan commit nilai asli.
# Fase 1 (situs statis) tidak memerlukan satupun variabel di bawah kecuali NEXT_PUBLIC_APP_URL.

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Fase 2+ (database & auth) ---
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Password DB dipakai docker-compose.yml (wajib diisi, tanpa default)
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://rumah_pramuka_app:<POSTGRES_PASSWORD>@127.0.0.1:5432/rumah_pramuka"
