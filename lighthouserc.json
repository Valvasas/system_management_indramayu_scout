{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/", "http://localhost:3000/berita", "http://localhost:3000/agenda"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
