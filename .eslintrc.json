{
  "root": true,
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended"],
  "plugins": ["jsx-a11y"],
  "rules": {
    "@next/next/no-img-element": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": [],
        "roles": ["tabpanel", "region"],
        "allowExpressionValues": true
      }
    ],
    "jsx-a11y/anchor-is-valid": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/lib/data/mock-data", "@/lib/data/*"],
            "message": "Akses data hanya lewat @/lib/repositories (TASKS.md P5-2)."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXAttribute[name.name='className'] Literal[value=/\\b(?:bg|text|border|ring|from|to|via|divide|outline|decoration|shadow)-(?:gray|green|blue|red|yellow|amber|emerald|slate|zinc|stone|orange|lime|teal|cyan|sky|indigo|violet|purple|fuchsia|pink|rose)-\\d{2,3}\\b/]",
        "message": "Jangan pakai warna literal Tailwind. Gunakan token semantic (surface-*, text-*, action-*, border-*, status-*)."
      },
      {
        "selector": "Literal[value=/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{FE0F}]/u]",
        "message": "Emoji dilarang di UI. Pakai ikon lucide-react dengan aria-hidden."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/repositories/**/*.ts", "src/lib/data/**/*.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["tailwind.config.ts", "src/styles/**"],
      "rules": { "no-restricted-syntax": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "out/", "generate_pages.js", "create_components.js"]
}
